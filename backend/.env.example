DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

TAVILY_API_KEY=your_tavily_api_key

REGISTRATION_INVITE_CODE=change-me
JWT_SECRET_KEY=change-me
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=spi_access
AUTH_REFRESH_COOKIE_NAME=spi_refresh
AUTH_CSRF_COOKIE_NAME=spi_csrf
AUTH_CSRF_SECRET=change-me
AUTH_REQUIRE_ORIGIN_CHECK=true
APP_TIMEZONE=Asia/Shanghai
DAILY_CHAT_LIMIT=10
DAILY_JOB_ANALYSIS_LIMIT=3
DAILY_INTERVIEW_EVALUATION_LIMIT=5
DAILY_MULTI_AGENT_TASK_LIMIT=3
DATA_RETENTION_DAYS=7

APP_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TRUSTED_PROXY_CIDRS=
RATE_LIMIT_HASH_SALT=change-me

MAX_REQUEST_BODY_MB=25
MAX_UPLOAD_FILE_SIZE_MB=20
MAX_UPLOAD_FILES_PER_REQUEST=1
MAX_USER_STORAGE_MB=200
MAX_PDF_PAGES=500
MAX_TEXT_LINE_CHARS=100000
MAX_FILENAME_CHARS=180

MAX_CHAT_INPUT_CHARS=6000
MAX_INTERVIEW_ANSWER_CHARS=12000
INTERVIEW_CONTEXT_CHAR_BUDGET=12000
MAX_JOB_DESCRIPTION_CHARS=30000
MAX_PROFILE_TEXT_CHARS=5000
MAX_TASK_INPUT_CHARS=12000

LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=1800
UPLOAD_RATE_LIMIT_ATTEMPTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_CHANGE_RATE_LIMIT_ATTEMPTS=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_REQUEST_NOTE_MAX_LENGTH=500
TEMPORARY_PASSWORD_TTL_HOURS=24
CHAT_BURST_RATE_LIMIT_ATTEMPTS=10
CHAT_BURST_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_WRITE_RATE_LIMIT_ATTEMPTS=10
ADMIN_WRITE_RATE_LIMIT_WINDOW_SECONDS=3600

CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
SQLITE_DB_PATH=./data/app.db
# 开发可留空并回退 SQLITE_DB_PATH；生产必须显式使用 postgresql+psycopg
# PostgreSQL 占位示例：postgresql+psycopg://app_user:change-me@postgres:5432/spi_app
DATABASE_URL=
ENABLE_LEGACY_SCHEMA_PATCHES=false
ENABLE_SYNC_LONG_TASK_COMPAT=false
JOB_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=10
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1
JOB_HISTORY_DAYS=30
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EVIDENCE_MAX_DISTANCE=0.8
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_MAX_CANDIDATES=40
