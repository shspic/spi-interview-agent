# 复制为仓库外的受限文件；不要提交 .env.production。
APP_PUBLIC_ORIGIN=https://example.com
APP_ENVIRONMENT=production
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
DATABASE_URL=postgresql+psycopg://spi_app:REPLACE_WITH_URL_ENCODED_SECRET@postgres:5432/spi_app
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
AUTH_CSRF_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
RATE_LIMIT_HASH_SALT=REPLACE_WITH_RANDOM_SECRET
REGISTRATION_INVITE_CODE=REPLACE_WITH_PRIVATE_INVITE
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_REQUIRE_ORIGIN_CHECK=true
CORS_ALLOWED_ORIGINS=https://example.com
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_REQUEST_NOTE_MAX_LENGTH=500
TEMPORARY_PASSWORD_TTL_HOURS=24
APP_TRUSTED_PROXY_CIDRS=172.30.0.0/24
ENABLE_LEGACY_SCHEMA_PATCHES=false
ENABLE_SYNC_LONG_TASK_COMPAT=false
WORKER_CONCURRENCY=2
